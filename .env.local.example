# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริงจาก Supabase (Project Settings > API)

# URL ของโปรเจกต์ Supabase เช่น https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon public key (ใช้ฝั่ง client ได้)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key (ความลับ! ใช้เฉพาะฝั่ง server สำหรับ admin สร้างบัญชีครู)
SUPABASE_SERVICE_ROLE_KEY=

# โดเมนสังเคราะห์สำหรับล็อกอินด้วยชื่อผู้ใช้ (ผู้ใช้กรอกแค่ชื่อผู้ใช้ ระบบต่อโดเมนนี้ให้เอง)
NEXT_PUBLIC_LOGIN_DOMAIN=grade.local
